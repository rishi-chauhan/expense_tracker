[Unit]
Description=Paisa Kidhar Gaya?! expense tracker
Documentation=file:///opt/expense_tracker/deploy/README.md
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=expenses
Group=expenses
WorkingDirectory=/opt/expense_tracker

# Optional env overrides (HOST, PORT, DB_PATH, ALLOWED_HOSTS, AUTH_PASSWORD_HASH,
# MAX_UPLOAD_SIZE, OLLAMA_*)
Environment=NODE_ENV=production
EnvironmentFile=-/opt/expense_tracker/.env

# Must be a real 0755 binary under /usr/local/bin — a symlink into /root/.bun
# is not executable by User=expenses (and ProtectHome=true would block it).
# One Bun process (not `bun run start`, which spawns a second runtime);
# --smol trades a little throughput for a smaller heap on the Pi.
ExecStart=/usr/local/bin/bun --smol src/server/index.js

# Guard rails: throttle at 200 MB, kill (then restart) at 300 MB.
MemoryHigh=200M
MemoryMax=300M

Restart=on-failure
RestartSec=5
TimeoutStopSec=20

# Hardening (app binds to 127.0.0.1 in production; Caddy fronts it)
UMask=0077
NoNewPrivileges=true
CapabilityBoundingSet=
AmbientCapabilities=
PrivateTmp=true
PrivateDevices=true
ProtectSystem=strict
ProtectHome=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictSUIDSGID=true
LockPersonality=true
# If you set DB_PATH outside these dirs, add that path here too.
ReadWritePaths=/opt/expense_tracker/data /opt/expense_tracker/backups

[Install]
WantedBy=multi-user.target
