[Unit]
Description=Paisa Kidhar Gaya?! expense tracker
Documentation=file:///opt/expense_tracker/deploy/README.md
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=expenses
Group=expenses
WorkingDirectory=/opt/expense_tracker

# Optional env overrides (HOST, PORT, DB_PATH, MAX_UPLOAD_SIZE, OLLAMA_*)
EnvironmentFile=-/opt/expense_tracker/.env

# Must be a real 0755 binary under /usr/local/bin — a symlink into /root/.bun
# is not executable by User=expenses (and ProtectHome=true would block it).
ExecStart=/usr/local/bin/bun run start

Restart=on-failure
RestartSec=5
TimeoutStopSec=20

# Hardening (app binds to 127.0.0.1 in production; Caddy fronts it)
UMask=0077
NoNewPrivileges=true
CapabilityBoundingSet=
AmbientCapabilities=
PrivateTmp=true
PrivateDevices=true
ProtectSystem=strict
ProtectHome=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictSUIDSGID=true
LockPersonality=true
# If you set DB_PATH outside these dirs, add that path here too.
ReadWritePaths=/opt/expense_tracker/data /opt/expense_tracker/backups

[Install]
WantedBy=multi-user.target
