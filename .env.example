# Server
NODE_ENV=production
PORT=3000
HOST=127.0.0.1

# Database (use an SSD path on the Pi when possible)
DB_PATH=data/expenses.db

# Upload limits
MAX_UPLOAD_SIZE=5242880

# Ollama AI (optional — leave unset / unused if Ollama is not installed)
OLLAMA_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen2.5:1.5b
