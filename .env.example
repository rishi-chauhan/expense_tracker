# Server
NODE_ENV=production
PORT=3000
# Always bind to localhost; Caddy / `tailscale serve` front the app.
HOST=127.0.0.1

# Host header allow-list (blocks DNS rebinding). Comma separated, no ports.
# setup.sh fills this in, e.g. localhost,127.0.0.1,expenses.home.lan,expenses.<tailnet>.ts.net
# Leave empty to disable the check.
ALLOWED_HOSTS=localhost,127.0.0.1

# Optional in-app password (off when empty). Generate with:
#   printf '%s' 'your password' | bun scripts/hash-password.js
# and paste it SINGLE-QUOTED (the hash contains '$'):
#   AUTH_PASSWORD_HASH='$argon2id$v=19$...'
AUTH_PASSWORD_HASH=
# Login session lifetime in days (only used when AUTH_PASSWORD_HASH is set)
SESSION_TTL_DAYS=30

# Database (use an SSD path on the Pi when possible)
DB_PATH=data/expenses.db

# Upload limits
MAX_UPLOAD_SIZE=5242880

# Ollama AI (optional — leave unset / unused if Ollama is not installed)
OLLAMA_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen2.5:1.5b
# 0 = skip the second "summarise" LLM call and show the result table instead.
# Halves AI latency on a Raspberry Pi 4 (recommended there).
OLLAMA_SUMMARIZE=1
# CPU threads for Ollama inference (4 on a Pi 4). Unset = Ollama default.
# OLLAMA_NUM_THREAD=4

# Optional off-device backups (deploy/backup.sh)
# BACKUP_REMOTE=/mnt/usb/expenses-backups
# BACKUP_AGE_RECIPIENT=age1...
